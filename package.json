{
  "name": "beton-decoratif-provence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/write-release.mjs",
    "build:pages": "vite build --mode pages && node scripts/write-release.mjs",
    "deploy:netlify": "python3 scripts/deploy-netlify.py",
    "deploy:pages": "bash scripts/deploy-pages.sh",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "sharp": "0.35.5",
    "vite": "8.3.3"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0"
  }
}
